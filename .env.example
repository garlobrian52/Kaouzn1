# Clerk authentication (configure in Clerk Dashboard / Vercel environment settings)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

AI_GATEWAY_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
AWS_REGION=
AWS_REVENUE_EVENTS_TABLE=

# StalkChain research (read-only by default)
STALKCHAIN_API_KEY=
STALKCHAIN_PROXY_SECRET=
TRADING_MODE=approval
LIVE_TRADING_ENABLED=false

# Independent StalkChain agent-wallet rail. Keep disabled until wallet custody,
# signing, allowlists, limits, and atomic approval consumption are implemented.
AGENT_WALLET_ENABLED=false
AGENT_WALLET_MAX_PER_TX_CENTS=0
AGENT_WALLET_DAILY_CAP_CENTS=0

# Crossmint Agent Commerce (separate card / checkout rail)
CROSSMINT_MCP_URL=https://agent-commerce.demos-crossmint.com/api/mcp
CROSSMINT_ENABLED=false
CROSSMINT_MAX_PER_PURCHASE_CENTS=2500
CROSSMINT_DAILY_CAP_CENTS=5000
CROSSMINT_MONTHLY_CAP_CENTS=15000
